{
  "name": "Open Research Request Beacon",
  "description": "Machine-readable discovery surface for bounded public research requests. Contributions are advisory and independently verified before use.",
  "version": "1.0",
  "status": "active",
  "interaction_mode": "asynchronous_public_research",
  "capabilities": [
    "research_request_discovery",
    "public_source_lead_submission",
    "bibliographic_evidence_submission",
    "correction_and_challenge_submission"
  ],
  "discovery": {
    "requests_index": "../../requests/index.json",
    "beacon": "../../beacon.json",
    "instructions": "../../llms.txt",
    "contribution_surface": "../../issues"
  },
  "constraints": {
    "publicly_accessible_sources_only": true,
    "external_content_execution": false,
    "verification_policy": "UNTRUSTED UNTIL VERIFIED",
    "operator_identity_disclosure_allowed": false,
    "contributor_self_declaration_required": false
  },
  "future": {
    "more_requests_expected": true,
    "sandboxed_synthetic_worker_interaction_may_be_added": true
  }
}
